#!/bin/sh
# Every push to main deploys, so run the same gate as CI first.
# Skip once with `git push --no-verify`.
set -e
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
changed=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  # main's history is what's deployed: never delete it or force-push over it.
  if [ "$remote_ref" = refs/heads/main ] && [ "$remote_sha" != "$zero" ]; then
    if [ "$local_sha" = "$zero" ] || ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "pre-push: refusing to delete or force-push main." >&2
      exit 1
    fi
  fi
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    # A new branch or tag: only commits the remote doesn't have yet count. A
    # tag on an already-pushed commit changes nothing, so nothing runs.
    changed="$changed
$(git log --name-only --format= "$local_sha" --not --remotes)"
  else
    changed="$changed
$(git diff --name-only "$remote_sha" "$local_sha")"
  fi
done

if printf '%s\n' "$changed" | grep -q '^apps/moonflow-pwa-react/'; then
  echo "pre-push: frontend gate (types, lint, tests, UTC tests, build)"
  # The sync integration tests run against the backend's pinned PocketBase.
  "$root/apps/moonflow-backend/scripts/fetch-pocketbase.sh" >/dev/null
  cd "$root/apps/moonflow-pwa-react"
  npx tsc -b
  npm run --silent lint
  npm test --silent
  LANG=en_US.UTF-8 TZ=UTC npm test --silent
  npm run --silent build
  cd "$root"
fi

if printf '%s\n' "$changed" | grep -q '^apps/moonflow-backend/'; then
  echo "pre-push: backend syntax + rule tests on a local PocketBase"
  cd "$root/apps/moonflow-backend"
  find pb_hooks pb_migrations -name '*.js' -exec node --check {} \;
  ./scripts/fetch-pocketbase.sh >/dev/null
  node --test 'test/**/*.test.mjs'
  cd "$root"
fi
